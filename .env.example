# ============================================================
# BALAJI ARCHITECT & INTERIORS — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================

# Supabase Project URL (e.g. https://YOUR-PROJECT-REF.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase Anon Public Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Supabase Service Role Secret Key (Server-side ONLY; NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# JWT Secret for Session Token Signing (Minimum 32 random characters)
JWT_SECRET=GENERATE_SECURE_RANDOM_JWT_SECRET

# Web Push VAPID Keys for Realtime Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@balajiinteriors.in

# Node Environment
NODE_ENV=production
