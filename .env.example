# ============================================================
# BALAJI ARCHITECT & INTERIORS — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================

# ------------------------------------------------------------
# Hostinger MySQL Database (phpMyAdmin)
# ------------------------------------------------------------
# Set DB_HOST to 'localhost' if running on Hostinger Node.js Web Hosting / VPS.
# If connecting from local dev or external servers, set DB_HOST to your Hostinger MySQL Server IP/host
# and enable "Remote MySQL" in Hostinger hPanel (Databases -> Remote MySQL -> Add Host '%').
DB_HOST=localhost
DB_PORT=3306
DB_USER=u603162798_balaji_arc_db
DB_PASSWORD=YOUR_HOSTINGER_DB_PASSWORD
DB_NAME=u603162798_balaji_arc_db
DATABASE_URL=mysql://u603162798_balaji_arc_db:YOUR_HOSTINGER_DB_PASSWORD@localhost:3306/u603162798_balaji_arc_db

# ------------------------------------------------------------
# Supabase PostgreSQL (Secondary / Fallback Engine)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ------------------------------------------------------------
# Security & JWT Session Cryptography
# ------------------------------------------------------------
JWT_SECRET=GENERATE_SECURE_RANDOM_JWT_SECRET

# ------------------------------------------------------------
# Web Push VAPID Keys
# ------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@balajiinteriors.in

# ------------------------------------------------------------
# Node Environment
# ------------------------------------------------------------
NODE_ENV=production

